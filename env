#!/bin/bash
# inacawo-deps/env — SST for deps-owned + shared LO / hindcast-base paths.
# Workflow-only paths (WPS, templates, …) live in $HOME/inacawo-iht/env.
#
#   source $HOME/inacawo-deps/env
#
# -----------------
# User / scratch roots
# -----------------
export HOME_DIR="${HOME}"
export USER_NAME="${USER}"
export SCRATCH="/scratch/${USER}"
#
# -----------------
# Deps root + conda
# -----------------
export DEPS_BASE="${HOME}/inacawo-deps"
export CONDA_BASE="${CONDA_BASE:-${DEPS_BASE}/miniforge3}"
if [[ ! -x "${CONDA_BASE}/bin/conda" && -x "${HOME}/opt/miniforge3/bin/conda" ]]; then
  # Legacy fallback until migrated to deps-local Miniforge
  export CONDA_BASE="${HOME}/opt/miniforge3"
fi
export HINDCAST_YML="${DEPS_BASE}/hindcast.yml"
export HINDCAST_ENV_NAME="${HINDCAST_ENV_NAME:-hindcast}"
# Always use envs under this Miniforge (ignore ~/.condarc envs_dirs like ~/envs)
export CONDA_ENVS_DIRS="${CONDA_BASE}/envs"
# Shared read-only hindcast env on scratch (offline / multi-user). Not under $HOME.
export HINDCAST_SHARED_ENV="${HINDCAST_SHARED_ENV:-/scratch/cawohdcst_ft2/inacawo-deps-cache/envs/hindcast}"
# Resolve active prefix: first *existing* conda env among
#   explicit HINDCAST_ENV_PREFIX → hindcast_env.prefix → local private → shared
# Stale exports / prefix files that point at a missing local env must not win
# over the shared offline env (common after install --offline in the same shell).
_HINDCAST_PREFIX_FILE="${DEPS_BASE}/hindcast_env.prefix"
_HINDCAST_LOCAL="${CONDA_ENVS_DIRS}/${HINDCAST_ENV_NAME}"
_HINDCAST_FILE_PREFIX=""
if [[ -f "${_HINDCAST_PREFIX_FILE}" ]]; then
  _HINDCAST_FILE_PREFIX="$(head -n 1 "${_HINDCAST_PREFIX_FILE}" | tr -d '\r')"
fi
_HINDCAST_PICKED=""
for _cand in \
  "${HINDCAST_ENV_PREFIX:-}" \
  "${_HINDCAST_FILE_PREFIX}" \
  "${_HINDCAST_LOCAL}" \
  "${HINDCAST_SHARED_ENV}"
do
  if [[ -n "${_cand}" && -d "${_cand}/conda-meta" ]]; then
    _HINDCAST_PICKED="${_cand}"
    break
  fi
done
if [[ -n "${_HINDCAST_PICKED}" ]]; then
  export HINDCAST_ENV_PREFIX="${_HINDCAST_PICKED}"
else
  # Prefer shared in the error path so setup_env hints at --offline correctly.
  export HINDCAST_ENV_PREFIX="${HINDCAST_SHARED_ENV}"
fi
unset _HINDCAST_PREFIX_FILE _HINDCAST_LOCAL _HINDCAST_FILE_PREFIX _HINDCAST_PICKED _cand
#
# -----------------
# Shared hindcast base (same value for deps install + iht workflow)
# -----------------
export CAWO_HINDCAST_BASE="${SCRATCH}/inacawo-iht"
#
# -----------------
# LiveOcean (code in deps; LO_user under iht home preprocess/; data on scratch)
# Scratch I/O siblings: cawo_input / cawo_hindcast_run / cawo_output / cawo_post
# -----------------
export LO="${DEPS_BASE}/LO"
# Per-user lo_tools package dir (shared env editable finder reads $LO)
export LO_TOOLS_PKG="${LO_TOOLS_PKG:-${LO}/lo_tools/lo_tools}"
export LO_USER="${HOME}/inacawo-iht/preprocess/LO_user"
# Allow override for maintainer staging into the shared forcing tree, e.g.
#   export CAWO_INPUT=/scratch/cawohdcst_ft2/data
# before sourcing setup_env / run_preprocess.
export CAWO_INPUT="${CAWO_INPUT:-${CAWO_HINDCAST_BASE}/cawo_input}"
export LO_DATA="${CAWO_INPUT}/LO_data"
export LO_OUTPUT="${CAWO_INPUT}/LO_output"
export LO_ROMS="${CAWO_INPUT}/LO_roms"
# Parker LO_roms_source_alt (edited varinfo.yaml used by zrfun.get_varinfo).
# Shared site copy; override LO_ROMS_SOURCE_ALT / LO_ROMS_VARINFO if needed.
export LO_ROMS_SOURCE_ALT="${LO_ROMS_SOURCE_ALT:-/scratch/cawohdcst_ft/home/cawohdcst/LO_roms_source_alt}"
export LO_ROMS_VARINFO="${LO_ROMS_VARINFO:-${LO_ROMS_SOURCE_ALT}/varinfo/varinfo.yaml}"
#
# ----------------
# Compiled model deps (NetCDF, HDF5, MCT, …) under $HOME/apps, extracted by
# install_hindcast_env.bash from the shared tarball on scratch.
# Intel/COAWST toolchain is a separate file — do not source from path SST;
# WPS/run scripts source COAWST_ENV only when needed.
# ----------------
export APPS_BASE="${APPS_BASE:-${HOME}/apps}"
export CAWO_DEPS_TARBALL_DIR="${CAWO_DEPS_TARBALL_DIR:-/scratch/cawohdcst_ft2/inacawo-iht/deps_tarballs}"
export CAWO_DEPS_TARBALL="${CAWO_DEPS_TARBALL:-${CAWO_DEPS_TARBALL_DIR}/apps.cawo_depends.mdclogin0.tar.gz}"
export LIBDEP="${APPS_BASE}/cawo_depends/intel_2021.5.1/build/lib"
export COAWST_ENV="${DEPS_BASE}/coawst.bash_env_intel.source_oneapi"
